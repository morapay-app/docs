{
  "theme": "mint",
  "name": "Morapay",
  "description": "Morapay Merchant API, SDK, and integration guides for checkout and payouts.",
  "colors": {
    "primary": "#0F172A",
    "light": "#F8FAFC",
    "dark": "#020617"
  },
  "logo": {
    "light": "/images/light.png",
    "dark": "/logo/dark.png"
  },
  "favicon": {
    "light": "/images/light.png",
    "dark": "/logo/dark.png"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#f6f5f4",
      "dark": "#18171a"
    }
  },
  "navbar": {
    "links": [
      {
        "href": "https://business.morapay.io/signup",
        "label": "Signup"
      },
      {
        "href": "https://business.morapay.io",
        "label": "Dashboard"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API keys",
      "href": "https://business.morapay.io/developers/api-keys"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/morapay",
      "github": "https://github.com/morapay"
    }
  },
  "seo": {
    "metatags": {
      "og:title": "Morapay Developer Docs",
      "og:description": "Merchant API, SDK, checkout widget, and business QR documentation.",
      "og:url": "https://docs.morapay.io",
      "og:type": "website"
    }
  },
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "fontawesome"
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/getting-started/quickstart"
    }
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ],
    "display": "header"
  },
  "$schema": "https://mintlify.com/docs.json",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/morapay"
        },
        {
          "anchor": "Support",
          "icon": "life-ring",
          "href": "mailto:support@morapay.io"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting started",
            "icon": "rocket",
            "pages": [
              "getting-started/quickstart",
              "getting-started/authentication",
              "getting-started/environments"
            ]
          },
          {
            "group": "Concepts",
            "icon": "lightbulb",
            "pages": [
              "concepts/payment-links",
              "concepts/subscriptions",
              "concepts/payouts-momo"
            ]
          },
          {
            "group": "Frontend & UI",
            "icon": "palette",
            "pages": [
              "frontend-ui/native-components",
              "frontend-ui/react-hooks",
              "frontend-ui/custom-styling"
            ]
          },
          {
            "group": "Developer tools",
            "icon": "wrench",
            "pages": [
              "developer-tools/webhooks",
              "developer-tools/idempotency"
            ]
          },
          {
            "group": "Errors",
            "icon": "triangle-exclamation",
            "pages": [
              "errors/error-handling",
              {
                "group": "Error codes",
                "pages": [
                  {
                    "group": "Authentication",
                    "pages": [
                      "errors/codes/auth-unauthorized",
                      "errors/codes/auth-forbidden",
                      "errors/codes/auth-keys-invalid",
                      "errors/codes/auth-keys-revoked",
                      "errors/codes/auth-keys-expired",
                      "errors/codes/auth-keys-legacy-unsupported",
                      "errors/codes/auth-keys-secret-in-header",
                      "errors/codes/auth-keys-origin-not-allowed",
                      "errors/codes/auth-signature-mismatch",
                      "errors/codes/auth-signature-timestamp-expired",
                      "errors/codes/auth-signature-incomplete",
                      "errors/codes/auth-signature-missing",
                      "errors/codes/auth-signature-invalid-timestamp",
                      "errors/codes/auth-signature-invalid-format"
                    ]
                  },
                  {
                    "group": "KYB & permissions",
                    "pages": [
                      "errors/codes/kyb-forbidden",
                      "errors/codes/kyb-blocked"
                    ]
                  },
                  {
                    "group": "Payment links",
                    "pages": [
                      "errors/codes/links-amount-below-minimum",
                      "errors/codes/links-slug-duplicate"
                    ]
                  },
                  {
                    "group": "Payouts & treasury",
                    "pages": [
                      "errors/codes/payouts-momo-insufficient-balance",
                      "errors/codes/payouts-network-carrier-down",
                      "errors/codes/payouts-clearing-refund-failed"
                    ]
                  },
                  {
                    "group": "Crypto checkout",
                    "pages": [
                      "errors/codes/crypto-chain-unsupported",
                      "errors/codes/crypto-slippage-exceeded"
                    ]
                  },
                  {
                    "group": "Resources & validation",
                    "pages": [
                      "errors/codes/resource-not-found",
                      "errors/codes/resource-conflict",
                      "errors/codes/request-invalid",
                      "errors/codes/request-validation-failed"
                    ]
                  },
                  {
                    "group": "Platform & connectivity",
                    "pages": [
                      "errors/codes/api-rate-limited",
                      "errors/codes/api-service-unavailable",
                      "errors/codes/api-internal-error",
                      "errors/codes/api-bad-gateway",
                      "errors/codes/api-gateway-timeout",
                      "errors/codes/api-connection-failed",
                      "errors/codes/api-proxy-core-unconfigured",
                      "errors/codes/api-proxy-signing-unconfigured",
                      "errors/codes/api-proxy-core-unreachable"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "group": "Support",
            "icon": "life-ring",
            "pages": [
              "support/get-help"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "code",
        "groups": [
          {
            "group": "Getting started",
            "icon": "book",
            "pages": [
              "api-reference/overview",
              "api-reference/conventions"
            ]
          },
          {
            "group": "Payments",
            "icon": "credit-card",
            "pages": [
              "api-reference/payment-links",
              "api-reference/products",
              "api-reference/business-qr",
              "api-reference/quotes",
              "api-reference/fiat-checkout"
            ]
          },
          {
            "group": "Transfers and payouts",
            "icon": "coins",
            "pages": [
              "api-reference/merchant-ramp",
              "api-reference/transactions",
              "api-reference/payout-methods",
              "api-reference/disbursement",
              "api-reference/payout-rails"
            ]
          },
          {
            "group": "Account",
            "icon": "building",
            "pages": [
              "api-reference/business-and-keys"
            ]
          },
          {
            "group": "Recurring and events",
            "icon": "rotate",
            "pages": [
              "api-reference/subscriptions",
              "api-reference/webhooks"
            ]
          },
          {
            "group": "Public checkout",
            "icon": "cart-shopping",
            "pages": [
              "api-reference/public-checkout"
            ]
          },
          {
            "group": "Catalog",
            "icon": "database",
            "pages": [
              "api-reference/catalog"
            ]
          }
        ]
      },
      {
        "tab": "Coverage",
        "icon": "table",
        "groups": [
          {
            "group": "Supported rails",
            "icon": "globe",
            "root": "reference/coverage",
            "pages": [
              "reference/countries-and-fiat",
              "reference/fees-countries-taxes",
              "reference/chains-and-tokens",
              "reference/banks-and-momo",
              "reference/disbursement-tokens",
              "reference/payout-timing"
            ]
          }
        ]
      }
    ]
  }
}
